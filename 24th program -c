#include<stdio.h>
#include<stdlib.h>
struct node
{
 int data;
 struct node *next;
};
struct node *adj[10];
int visited[10];
int stack[10];
int top=-1, bottom=0;
void push(int v)
{
 stack[++top]=v;
}
int pop()
{
 return stack[bottom++];
}
int main()
{
 int n,e,i,u,v,start;
 struct node *temp;
 printf("Enter number of vertices: ");
 scanf("%d",&n);
 for(i=0;i<n;i++)
 {
 adj[i]=NULL;
 visited[i]=0;
 }
 printf("Enter number of edges: ");
 scanf("%d",&e);
 for(i=0;i<e;i++)
 {
 scanf("%d%d",&u,&v);
 temp=(struct node*)malloc(sizeof(struct node));
 temp->data=v;
 temp->next=adj[u];
 adj[u]=temp;
 temp=(struct node*)malloc(sizeof(struct node));
 temp->data=u;
 temp->next=adj[v];
 adj[v]=temp;
 }
 printf("Enter starting vertex: ");
 scanf("%d",&start);
 push(start);
 visited[start]=1;
 printf("BFS traversal: ");
 while(bottom<=top)
 {
 v=pop();
 printf("%d ",v);
 temp=adj[v];
 while(temp!=NULL)
 {
 if(visited[temp->data]==0)
 {
 push(temp->data);
 visited[temp->data]=1;
 }
 temp=temp->next;
 }
 }
 system("getmac");
 return 0;
}
