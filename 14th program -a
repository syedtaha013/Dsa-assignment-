#include<stdio.h>
#include<time.h>
int main()
{
 int a[100],n,i,pos,val;
 clock_t start,end;
 double time_taken;
 printf("Enter number of elements: ");
 scanf("%d",&n);
 for(i=0;i<n;i++)
 scanf("%d",&a[i]);
 printf("Enter position for insertion: ");
 scanf("%d",&pos);
 printf("Enter value to insert: ");
 scanf("%d",&val);
 start=clock();
 for(i=n;i>=pos;i--)
 a[i]=a[i-1];
 a[pos-1]=val;
 n++;
 end=clock();
 time_taken=(double)(end-start)/CLOCKS_PER_SEC;
 printf("Time taken for insertion: %f seconds\n",time_taken);
 printf("Enter position for deletion: ");
 scanf("%d",&pos);
 start=clock();
 for(i=pos-1;i<n-1;i++)
 a[i]=a[i+1];
 n--;
 end=clock();
 time_taken=(double)(end-start)/CLOCKS_PER_SEC;
 printf("Time taken for deletion: %f seconds\n",time_taken);
 printf("Final array: ");
 for(i=0;i<n;i++)
 printf("%d ",a[i]);
system("getmac"); 
 return 0;
}
