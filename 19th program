#include<stdio.h>
#include<stdlib.h>
struct node
{
 int data;
 struct node *left,*right;
};
struct node* create(int val)
{
 struct node *n=(struct node*)malloc(sizeof(struct node));
 n->data=val;
 n->left=NULL;
 n->right=NULL;
 return n;
}
int main()
{
 struct node *root=NULL,*queue[50],*temp;
 int front=0,rear=0;
 int val,lval,rval;
 printf("Enter root value: ");
 scanf("%d",&val);
 if(val==-1)
 return 0;
 root=create(val);
 queue[rear++]=root;
 while(front<rear)
 {
 temp=queue[front++];
 printf("Enter left child of %d: ",temp->data);
 scanf("%d",&lval);
 if(lval!=-1)
 {
 temp->left=create(lval);
 queue[rear++]=temp->left;
 }
 printf("Enter right child of %d: ",temp->data);
 scanf("%d",&rval);
 if(rval!=-1)
 {
 temp->right=create(rval);
 queue[rear++]=temp->right;
}
 }
 printf("Binary tree created successfully\n");
system("getmac"); 
 return 0;
}
