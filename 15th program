#include<stdio.h>
int main()
{
 int a[10][10], s[50][3];
 int r,c,i,j,k=1,count=0;
 printf("Enter rows and columns: ");
 scanf("%d%d",&r,&c);
 printf("Enter matrix elements:\n");
 for(i=0;i<r;i++)
 for(j=0;j<c;j++)
 scanf("%d",&a[i][j]);
 for(i=0;i<r;i++)
 for(j=0;j<c;j++)
 if(a[i][j]!=0)
 count++;
 s[0][0]=r;
 s[0][1]=c;
 s[0][2]=count;
 for(i=0;i<r;i++)
 for(j=0;j<c;j++)
 if(a[i][j]!=0)
 {
 s[k][0]=i;
 s[k][1]=j;
 s[k][2]=a[i][j];
k++;
 }
 printf("Sparse matrix (row col value):\n");
 for(i=0;i<=count;i++)
 printf("%d %d %d\n",s[i][0],s[i][1],s[i][2]);
system("getmac"); 
 return 0;
}
